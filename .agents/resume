#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"

# Toolchains persist across pause/resume; only check readiness here.
hugo version
if [[ ! -f "$repo_root/themes/devise/assets/sass/override.scss" ]]; then
    echo "Devise is not initialized; run .agents/setup to restore it." >&2
    exit 1
fi
